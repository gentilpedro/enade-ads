@using EnadeAds.Accounts
@using EnadeAds.Study

@inject NavigationManager Navigation
@inject TrackCatalog Tracks

<header class="site-header">
    <div class="site-header-inner">
        <div class="brand-group">
            <a class="brand" href="">Rumo</a>
            @* A trilha ativa ao lado da marca: "Rumo ENEM". Clicar troca de trilha, sem JavaScript. *@
            <details class="track-menu">
                <summary aria-label="Trilha: @track?.Name. Trocar de trilha">
                    <span class="track-label">@track?.Label</span>
                    <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
                </summary>
                <div class="track-panel">
                    <p class="track-panel-title">Estudar para</p>
                    @foreach (var option in tracks)
                    {
                        var isCurrent = option.Id == track?.Id;
                        <a href="@SwitchUrl(option)" aria-current="@(isCurrent ? "true" : null)" class="@(isCurrent ? "is-current" : null)">
                            <span class="track-option-name">@option.Name</span>
                            <span class="track-option-level">@option.Level.LevelName()</span>
                        </a>
                    }
                </div>
            </details>
        </div>

        <nav class="primary-nav" aria-label="Seções">
            <NavLink href="" Match="NavLinkMatch.All">Início</NavLink>
            <NavLink href="roadmap">Roadmap</NavLink>
            <NavLink href="materias">Matérias</NavLink>
            <NavLink href="questoes">Questões</NavLink>
            <NavLink href="desafios">Desafios</NavLink>
            <NavLink href="simulados">Simulados</NavLink>
        </nav>

        <div class="header-tools">
            @* Botão em HTML puro (wwwroot/js/theme.js) de propósito: funciona em
               páginas estáticas, sem precisar de render mode interativo. *@
            <button type="button" class="icon-button" data-theme-toggle onclick="appTheme.toggle()"
                    title="Alternar tema claro/escuro" aria-label="Alternar tema claro/escuro">
                <svg class="theme-icon theme-icon-moon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278" />
                </svg>
                <svg class="theme-icon theme-icon-sun" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6m0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708" />
                </svg>
            </button>

            <AuthorizeView>
                <Authorized>
                    @* <details> abre o menu sem JavaScript; a navegação seguinte devolve ele fechado. *@
                    <details class="account-menu">
                        <summary aria-label="Menu da conta">
                            <span class="avatar" aria-hidden="true">@Initial(context.User.Identity?.Name)</span>
                            <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
                        </summary>
                        <div class="account-panel">
                            <p class="account-name">@context.User.Identity?.Name</p>
                            <a href="meu-desempenho">Meu desempenho</a>
                            <a href="Account/Manage">Minha conta</a>
                            <AuthorizeView Roles="@Roles.Editors" Context="editor">
                                <a href="moderacao">Moderação</a>
                            </AuthorizeView>
                            <AuthorizeView Roles="@Roles.Admin" Context="admin">
                                <p class="account-group">Administração</p>
                                <a href="admin/professores-pendentes">Professores pendentes</a>
                                <a href="admin/contas">Contas</a>
                                <a href="admin/data-da-prova">Data da prova</a>
                            </AuthorizeView>
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit">Sair</button>
                            </form>
                        </div>
                    </details>
                </Authorized>
                <NotAuthorized>
                    <a class="header-link" href="Account/Login">Entrar</a>
                    <a class="header-cta" href="Account/Register">Criar conta</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@code {
    private string? currentUrl;
    private Track? track;
    private IReadOnlyList<Track> tracks = [];

    protected override async Task OnInitializedAsync()
    {
        currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        track = await Tracks.CurrentAsync();
        tracks = await Tracks.ListAsync();
    }

    /// <summary>
    /// Volta para a mesma seção na outra trilha. Páginas de um item (uma matéria, uma questão) voltam para a lista,
    /// porque o item é da trilha anterior; conta e admin voltam para a mesma página.
    /// </summary>
    private string SwitchUrl(Track option)
    {
        var path = (currentUrl ?? "").Split('?', '#')[0];
        var first = path.Split('/')[0];
        var back = first is "Account" or "admin" ? "/" + path : "/" + first;
        return $"trilha/{option.Slug}?volta={Uri.EscapeDataString(back)}";
    }

    private static string Initial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();
}
