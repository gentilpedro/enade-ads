@implements IDisposable

@using EnadeAds.Accounts

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ENADE ADS</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Início
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="roadmap">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Roadmap
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="materias">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Matérias
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="questoes">
                <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Questões
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="desafios">
                <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Desafios
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="simulados">
                <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Simulados
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="blog">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Blog
            </NavLink>
        </div>

        <AuthorizeView Roles="@Roles.Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/professores-pendentes">
                    <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Professores pendentes
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/contas">
                    <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Contas
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/data-da-prova">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Data da prova
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="meu-desempenho">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Meu desempenho
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Minha conta
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Sair
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Criar conta
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Entrar
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

