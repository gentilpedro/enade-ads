@using System.Globalization
@using EnadeAds.Study

@inject TrackCatalog Tracks
@inject LocalCalendar Calendar

@* Início de quem ainda não escolheu a prova: nada vem pré-selecionado. *@
<section class="chooser" aria-labelledby="chooser-title">
    <h1 id="chooser-title">Para qual prova você vai estudar?</h1>
    <p class="chooser-lead">
        O Rumo é uma plataforma aberta e gratuita de estudo. Cada prova tem um roadmap, questões com gabarito comentado,
        simulados com tempo e uma comunidade. Você troca de prova quando quiser, no topo da página.
    </p>

    <ol class="chooser-list">
        @foreach (var track in tracks)
        {
            var days = track.ExamDays.Where(day => day >= today).Select(day => day.DayNumber - today.DayNumber).DefaultIfEmpty(-1).Min();
            <li>
                <a class="chooser-option" href="@($"trilha/{track.Slug}?volta={Uri.EscapeDataString(Volta)}")">
                    <span class="label-narrow chooser-level">@track.Level.LevelName()</span>
                    <span class="chooser-name">@track.Name</span>
                    <span class="chooser-basis">@track.Basis</span>
                    <span class="chooser-date">
                        Prova em @string.Join(" e ", track.ExamDays.Select(day => day.ToString("dd/MM/yyyy", Culture)))
                        @if (days == 0)
                        {
                            <text> · é hoje</text>
                        }
                        else if (days > 0)
                        {
                            <text> · faltam @days @(days == 1 ? "dia" : "dias")</text>
                        }
                    </span>
                    <span class="chooser-go">Estudar para @track.ExamName <span aria-hidden="true">→</span></span>
                </a>
            </li>
        }
    </ol>

    <p class="chooser-soon">Em breve: seletivos dos institutos federais, como o IFSul. O código é aberto, e quem quiser pode ajudar a montar a trilha.</p>
</section>

@code {
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("pt-BR");

    private IReadOnlyList<Track> tracks = [];
    private DateOnly today;

    /// <summary>Para onde ir depois de escolher (a página que a pessoa tentou abrir).</summary>
    [Parameter]
    public string Volta { get; set; } = "/";

    protected override async Task OnInitializedAsync()
    {
        today = Calendar.Today();
        tracks = await Tracks.ListAsync();
    }
}
