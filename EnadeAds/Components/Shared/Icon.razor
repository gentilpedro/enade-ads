@* Ícones desenhados no mesmo traço das abas do celular, no lugar de caracteres como ✓ e ↷. Decorativos: o texto ao lado diz o que são. *@
<svg class="icon @Class" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "check":
            <path d="M3 8.5 6.5 12 13 4.5" />
            break;
        case "x":
            <path d="M4 4l8 8M12 4l-8 8" />
            break;
        case "pencil":
            <path d="M10.5 2.5l3 3L6 13H3v-3z" />
            break;
        case "half":
            <circle cx="8" cy="8" r="5.5" />
            <path d="M8 2.5v11A5.5 5.5 0 0 0 8 2.5z" class="icon-fill" />
            break;
        case "skip":
            <path d="M3 10a5 5 0 0 1 9-3M12.5 3v4h-4" />
            break;
    }
</svg>

@code {
    /// <summary>check, x, pencil, half ou skip.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter]
    public string? Class { get; set; }
}
