<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preload" href="fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["EnadeAds.styles.css"]" />
    <ImportMap />
    @* Pelo @Assets o endereço muda junto com a imagem, e o navegador não fica com o ícone antigo em cache. *@
    <link rel="icon" type="image/png" sizes="64x64" href="@Assets["favicon.png"]" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />
    <!-- Bloqueante de propósito: aplica o tema antes do primeiro paint. -->
    <script src="@Assets["js/theme.js"]"></script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <script>
        // A navegação aprimorada sincroniza o DOM com o HTML vindo do servidor,
        // o que reverteria o data-bs-theme do <html>. Reaplica a cada navegação.
        Blazor.addEventListener('enhancedload', function () { window.appTheme.apply(); });
    </script>
</body>

</html>
