@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using EnadeAds.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Dados pessoais</PageTitle>

<StatusMessage />
<h3>Dados pessoais</h3>

<div class="row">
    <div class="col-md-6">
        <p>Sua conta guarda os dados pessoais que você nos forneceu. Nesta página você pode baixar ou excluir esses dados.</p>
        <p>
            <strong>Excluir estes dados apaga sua conta para sempre. Não será possível recuperá-la.</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Baixar</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Excluir</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
