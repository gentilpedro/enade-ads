@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using EnadeAds.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Dados pessoais</PageTitle>

<StatusMessage />
<h3>Dados pessoais</h3>

<div class="row">
    <div class="col-md-6">
        <p>
            <strong>Baixar</strong> gera um arquivo com a sua conta e tudo o que você fez na plataforma: progresso no roadmap,
            respostas, simulados, desafios e comentários. Veja a <a href="privacidade">política de privacidade</a>.
        </p>
        <p>
            <strong>Excluir</strong> apaga sua conta para sempre. Não será possível recuperá-la.
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Baixar</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Excluir</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
