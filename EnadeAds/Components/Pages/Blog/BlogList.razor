@page "/blog"

@using EnadeAds.Accounts
@using EnadeAds.Blog
@using EnadeAds.Data
@using EnadeAds.Questions
@using EnadeAds.Study
@using Microsoft.AspNetCore.Identity

@inject BlogService Blog
@inject LocalCalendar Calendar
@inject UserManager<ApplicationUser> Users

<PageTitle>Blog do ENADE</PageTitle>

<HeadContent>
    <link rel="alternate" type="application/rss+xml" title="ENADE ADS – atualizações" href="@BlogFeed.Path.TrimStart('/')" />
</HeadContent>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
    <h1>Atualizações do ENADE</h1>
    <AuthorizeView Roles="@Roles.Editors">
        <a class="btn btn-primary" href="blog/novo">Novo post</a>
    </AuthorizeView>
</div>

<p class="text-body-secondary">
    Datas e prazos do Inep, portarias e editais, dicas de estudo e avisos da turma.
    <a href="@BlogFeed.Path.TrimStart('/')">Assine o feed RSS</a>.
</p>

<nav aria-label="Categorias" class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-sm @(category is null ? "btn-dark" : "btn-outline-secondary")" href="blog" aria-current="@(category is null ? "page" : null)">Todas</a>
    @foreach (var item in PostCategoryNames.All)
    {
        <a class="btn btn-sm @(category == item ? "btn-dark" : "btn-outline-secondary")" href="blog?categoria=@item.Slug()"
           aria-current="@(category == item ? "page" : null)">@item.Name()</a>
    }
</nav>

@if (notPublished is { Count: > 0 })
{
    <details class="mb-4">
        <summary>Seus rascunhos e posts arquivados (@notPublished.Count)</summary>
        <ul class="mt-2">
            @foreach (var post in notPublished)
            {
                <li>
                    <a href="blog/@post.Slug">@post.Title</a>
                    <span class="badge @(post.ArchivedAt is null ? "text-bg-warning" : "text-bg-secondary")">@(post.ArchivedAt is null ? "Rascunho" : "Arquivado")</span>
                </li>
            }
        </ul>
    </details>
}

@if (result is not null)
{
    @if (result.Items.Count == 0)
    {
        <p>Nenhum post @(category is null ? "publicado ainda" : "nesta categoria ainda").</p>
    }

    @foreach (var post in result.Items)
    {
        <article class="card mb-3 @(post.PinnedAt is not null ? "border-primary border-2" : "")">
            <div class="card-body">
                <p class="small text-body-secondary mb-1">
                    @if (post.PinnedAt is not null)
                    {
                        <span class="badge text-bg-primary me-1">Fixado</span>
                    }
                    <a href="blog?categoria=@post.Category.Slug()" class="text-body-secondary">@post.Category.Name()</a>
                    · <time datetime="@post.PublishedAt!.Value.ToString("O")">@Calendar.ToLocal(post.PublishedAt.Value).ToString("dd/MM/yyyy")</time>
                </p>
                <h2 class="h5"><a href="blog/@post.Slug" class="stretched-link text-decoration-none">@post.Title</a></h2>
                <p class="mb-0 text-body-secondary">@post.Summary</p>
            </div>
        </article>
    }

    @if (result.TotalPages > 1)
    {
        <nav aria-label="Páginas do blog">
            <ul class="pagination">
                @for (var number = 1; number <= result.TotalPages; number++)
                {
                    <li class="page-item @(number == result.Page ? "active" : "")">
                        <a class="page-link" href="@PageUrl(number)" aria-current="@(number == result.Page ? "page" : null)">@number</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

@code {
    private PostPage? result;
    private IReadOnlyList<Post>? notPublished;
    private PostCategory? category;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "categoria")]
    private string? CategorySlug { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    private int? Pagina { get; set; }

    protected override async Task OnInitializedAsync()
    {
        category = PostCategoryNames.FromSlug(CategorySlug);
        result = await Blog.ListAsync(category, Pagina ?? 1);

        var editor = EditorFactory.From(HttpContext.User, Users.GetUserId(HttpContext.User));
        if (editor?.CanCreate == true)
        {
            notPublished = await Blog.NotPublishedAsync(editor);
        }
    }

    private string PageUrl(int number) =>
        category is null ? $"blog?pagina={number}" : $"blog?categoria={category.Value.Slug()}&pagina={number}";
}
