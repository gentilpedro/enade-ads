@page "/materias/{Slug}"

@using EnadeAds.Study

@inject SubjectCatalog Catalog
@inject EnadeAds.Questions.QuestionBank Questions
@inject NavigationManager Navigation

@if (subject is not null)
{
    <PageTitle>@subject.Title</PageTitle>

    <nav aria-label="Trilha">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="materias">Matérias</a></li>
            <li class="breadcrumb-item active" aria-current="page">@subject.Title</li>
        </ol>
    </nav>

    <p class="text-body-secondary small text-uppercase fw-semibold mb-1">@subject.Block.Name()</p>
    <h1>@subject.Title</h1>
    <p class="lead">@subject.Summary</p>
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-primary" href="questoes?materia=@subject.Slug">Praticar questões (@questionCount)</a>
        <a class="btn btn-outline-primary" href="roadmap?topico=@subject.Slug#no-@subject.Slug">Ver no roadmap</a>
        <AuthorizeView Roles="@EnadeAds.Accounts.Roles.Editors">
            <a class="btn btn-outline-secondary" href="roadmap/editar/@subject.Slug">Editar matéria</a>
        </AuthorizeView>
    </div>

    <h2 class="h4 mt-4">Assuntos</h2>
    <dl>
        @foreach (var topic in subject.Topics)
        {
            <dt><a href="roadmap?topico=@topic.Slug#no-@topic.Slug">@topic.Title</a></dt>
            <dd class="mb-3">@topic.Summary</dd>
        }
    </dl>
}

@code {
    private RoadmapNode? subject;
    private int questionCount;

    [Parameter]
    public string Slug { get; set; } = "";

    protected override async Task OnParametersSetAsync()
    {
        subject = await Catalog.FindAsync(Slug);
        if (subject is null)
        {
            Navigation.NotFound();
            return;
        }

        questionCount = await Questions.CountBySubjectAsync(subject.Id);
    }
}
