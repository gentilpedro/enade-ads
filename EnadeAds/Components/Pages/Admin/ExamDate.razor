@page "/admin/data-da-prova"

@using Microsoft.AspNetCore.Authorization
@using EnadeAds.Accounts
@using EnadeAds.Study

@attribute [Authorize(Roles = Roles.Admin)]

@inject ExamSettings Settings
@inject TrackCatalog Tracks
@inject LocalCalendar Calendar

<PageTitle>Data da prova</PageTitle>

<h1 class="h3">Data da prova</h1>
<p class="text-body-secondary">
    Datas da trilha <strong>@track?.Name</strong>. A contagem regressiva e a faixa do semestre usam estas datas.
    Confira no edital oficial. Para mudar outra trilha, troque a trilha no topo da página.
</p>

@if (message is not null)
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")" role="status">@message</div>
}

@* O modelo nasce depois de consultar o banco; no PostgreSQL a página renderiza antes disso, com ele ainda vazio. *@
@if (Input is not null)
{
    <EditForm Model="Input" method="post" FormName="exam-date" OnSubmit="SaveAsync">
        <div class="mb-3">
            <label for="Input.Date" class="form-label">Dia da prova (ou primeiro dia)</label>
            <InputDate @bind-Value="Input.Date" id="Input.Date" class="form-control w-auto" />
        </div>
        <div class="mb-3">
            <label for="Input.SecondDate" class="form-label">Segundo dia <span class="text-body-secondary">(opcional, como no ENEM)</span></label>
            <InputDate @bind-Value="Input.SecondDate" id="Input.SecondDate" class="form-control w-auto" />
        </div>
        <button type="submit" class="btn btn-primary">Salvar</button>
    </EditForm>
}

@code {
    private string? message;
    private bool isError;
    private Track? track;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "exam-date")]
    private ExamDateModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        track = await Tracks.CurrentAsync();
        Input ??= new ExamDateModel { Date = track.ExamDate, SecondDate = track.SecondExamDate };
    }

    private async Task SaveAsync()
    {
        // Data no passado zeraria a contagem regressiva de todos os alunos: provável erro de digitação.
        if (Input.Date < Calendar.Today())
        {
            isError = true;
            message = "A data da prova não pode estar no passado.";
            HttpContext.Response.StatusCode = StatusCodes.Status400BadRequest;
            return;
        }

        if (Input.SecondDate is { } second && second <= Input.Date)
        {
            isError = true;
            message = "O segundo dia precisa vir depois do primeiro.";
            HttpContext.Response.StatusCode = StatusCodes.Status400BadRequest;
            return;
        }

        await Settings.SetExamDatesAsync(Input.Date, Input.SecondDate);
        message = Input.SecondDate is { } day
            ? $"Datas salvas: {Input.Date:dd/MM/yyyy} e {day:dd/MM/yyyy}."
            : $"Data da prova salva: {Input.Date:dd/MM/yyyy}.";
    }

    private sealed class ExamDateModel
    {
        public DateOnly Date { get; set; }
        public DateOnly? SecondDate { get; set; }
    }
}
