@page "/questoes/{Id:int}"

@using EnadeAds.Accounts
@using EnadeAds.Data
@using EnadeAds.Questions
@using Microsoft.AspNetCore.Identity

@inject QuestionBank Bank
@inject UserManager<ApplicationUser> Users
@inject NavigationManager Navigation

@if (question is not null)
{
    var subject = question.Subject!;
    var discursive = question.Kind == QuestionKind.Discursive;

    <PageTitle>Questão @question.Id · @subject.Title</PageTitle>

    <nav aria-label="Trilha">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="questoes">Questões</a></li>
            <li class="breadcrumb-item"><a href="questoes?materia=@subject.Slug">@subject.Title</a></li>
            <li class="breadcrumb-item active" aria-current="page">Questão @QuestionCode.Label(question.Id, question.ExternalKey)</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
        <h1 class="h3">Questão @QuestionCode.Label(question.Id, question.ExternalKey) @if (discursive) { <span class="badge text-bg-secondary align-middle fs-6">Discursiva</span> }</h1>
        @if (editor?.CanEdit(question) == true)
        {
            <a class="btn btn-sm btn-outline-secondary" href="questoes/@question.Id/editar">Editar questão</a>
        }
    </div>
    <p class="small text-body-secondary">@subject.Title · @question.Source</p>

    @* HTML gerado pelo StatementFormatter: todo texto é escapado e só tags fixas são adicionadas. *@
    <div class="question-statement mb-4">@((MarkupString)StatementFormatter.ToHtml(question.Statement))</div>

    @if (discursive)
    {
        @if (discursiveAnswer is not null && !Retry)
        {
            <div class="alert alert-info" role="status">
                Resposta enviada. Compare com o padrão de resposta e anote o que faltou no seu caderno de erros.
            </div>

            <div class="row g-3">
                <section class="col-lg-6" aria-labelledby="my-answer">
                    <h2 id="my-answer" class="h6">Sua resposta</h2>
                    @* Texto do aluno renderizado como texto: o Blazor escapa, e as quebras de linha vêm do CSS. *@
                    <div class="card"><div class="card-body discursive-text">@discursiveAnswer.Text</div></div>
                </section>
                <section class="col-lg-6" aria-labelledby="expected-answer">
                    <h2 id="expected-answer" class="h6">Padrão de resposta</h2>
                    <div class="card border-success">
                        <div class="card-body question-statement">@((MarkupString)StatementFormatter.ToHtml(question.ExpectedAnswer ?? ""))</div>
                    </div>
                </section>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-3">
                <a class="btn btn-outline-primary" href="questoes/@question.Id?refazer=1">Escrever de novo</a>
                <a class="btn btn-link" href="questoes?materia=@subject.Slug">Mais questões de @subject.Title</a>
            </div>
        }
        else if (userId is not null)
        {
            <form method="post" action="questoes/@question.Id" @formname="discursive-answer" @onsubmit="AnswerDiscursiveAsync">
                <AntiforgeryToken />
                <label for="AnswerText" class="form-label h6">Sua resposta</label>
                @if (invalidChoice)
                {
                    <p class="text-danger" role="alert">Escreva sua resposta (até @QuestionBank.DiscursiveAnswerMaxLength caracteres) antes de enviar.</p>
                }
                <textarea id="AnswerText" name="AnswerText" class="form-control" rows="@(question.SuggestedLines ?? 15)"
                          maxlength="@QuestionBank.DiscursiveAnswerMaxLength" required aria-describedby="answer-help">@AnswerText</textarea>
                <div id="answer-help" class="form-text">
                    Tamanho sugerido: cerca de @(question.SuggestedLines ?? 15) linhas. Depois de enviar, você vê o padrão de resposta. Só você vê o que escreveu.
                </div>
                <button type="submit" class="btn btn-primary mt-2">Enviar resposta</button>
            </form>
        }
        else
        {
            <div class="alert alert-info" role="status">
                <a href="@LoginUrl">Entre</a> ou <a href="Account/Register">crie sua conta</a> para escrever sua resposta e ver o padrão de resposta.
            </div>
        }
    }
    else if (latest is not null && !Retry)
    {
        var chosen = question.Options.First(o => o.Id == latest.OptionId);

        <div class="alert @(latest.IsCorrect ? "alert-success" : "alert-danger")" role="status">
            @if (latest.IsCorrect)
            {
                <strong><Icon Name="check" /> Você acertou.</strong> <span>A resposta é a alternativa @chosen.Letter.</span>
            }
            else
            {
                var correct = question.Options.First(o => o.IsCorrect);
                <strong><Icon Name="x" /> Você marcou @chosen.Letter.</strong> <span>A resposta correta é a alternativa @correct.Letter.</span>
            }
        </div>

        <ol class="list-unstyled d-flex flex-column gap-2">
            @foreach (var option in question.Options)
            {
                <li class="card @OptionClass(option, chosen)">
                    <div class="card-body">
                        <p class="mb-1">
                            <strong>@option.Letter)</strong> <OptionText Text="@option.Text" />
                            @if (option.IsCorrect)
                            {
                                <span class="badge text-bg-success ms-1">Correta</span>
                            }
                            @if (option.Id == chosen.Id && !option.IsCorrect)
                            {
                                <span class="badge text-bg-danger ms-1">Sua resposta</span>
                            }
                        </p>
                        <p class="small text-body-secondary mb-0">@option.Explanation</p>
                    </div>
                </li>
            }
        </ol>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <a class="btn btn-outline-primary" href="questoes/@question.Id?refazer=1">Responder de novo</a>
            <a class="btn btn-link" href="questoes?materia=@subject.Slug">Mais questões de @subject.Title</a>
        </div>
    }
    else if (userId is not null)
    {
        <form method="post" action="questoes/@question.Id" @formname="answer" @onsubmit="AnswerAsync">
            <AntiforgeryToken />
            <fieldset>
                <legend class="h6">Escolha uma alternativa</legend>
                @if (invalidChoice)
                {
                    <p class="text-danger" role="alert">Escolha uma das alternativas antes de responder.</p>
                }
                @foreach (var option in question.Options)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="Letter" id="opcao-@option.Letter" value="@option.Letter" required />
                        <label class="form-check-label" for="opcao-@option.Letter"><strong>@option.Letter)</strong> <OptionText Text="@option.Text" /></label>
                    </div>
                }
            </fieldset>
            <button type="submit" class="btn btn-primary mt-2">Responder</button>
        </form>
    }
    else
    {
        <ol class="list-unstyled d-flex flex-column gap-2 mb-3">
            @foreach (var option in question.Options)
            {
                <li><strong>@option.Letter)</strong> <OptionText Text="@option.Text" /></li>
            }
        </ol>
        <div class="alert alert-info" role="status">
            <a href="@LoginUrl">Entre</a> ou <a href="Account/Register">crie sua conta</a> para responder e ver o gabarito comentado.
        </div>
    }
}

@code {
    private Question? question;
    private QuestionAttempt? latest;
    private DiscursiveAnswer? discursiveAnswer;
    private string? userId;
    private Editor? editor;
    private bool invalidChoice;

    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "refazer")]
    private int? RetryFlag { get; set; }

    [SupplyParameterFromForm(FormName = "answer")]
    private string? Letter { get; set; }

    [SupplyParameterFromForm(FormName = "discursive-answer")]
    private string? AnswerText { get; set; }

    private bool Retry => RetryFlag == 1;

    private string LoginUrl => $"Account/Login?ReturnUrl={Uri.EscapeDataString($"/questoes/{Id}")}";

    protected override async Task OnInitializedAsync()
    {
        question = await Bank.FindAsync(Id);
        if (question is null)
        {
            Navigation.NotFound();
            return;
        }

        userId = Users.GetUserId(HttpContext.User);
        editor = EditorFactory.From(HttpContext.User, userId);
        if (userId is null)
        {
            return;
        }

        if (question.Kind == QuestionKind.Discursive)
        {
            discursiveAnswer = await Bank.LatestDiscursiveAnswerAsync(userId, Id);
        }
        else
        {
            latest = await Bank.LatestAttemptAsync(userId, Id);
        }
    }

    private async Task AnswerAsync()
    {
        // Regra de negócio: responder exige login. O formulário não aparece para visitante, mas o POST pode ser forjado.
        if (userId is null || question is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status401Unauthorized;
            return;
        }

        var answer = Letter is { Length: 1 } ? await Bank.AnswerAsync(userId, question.Id, Letter[0]) : null;
        if (answer is null)
        {
            invalidChoice = true;
            HttpContext.Response.StatusCode = StatusCodes.Status400BadRequest;
            return;
        }

        latest = answer.Attempt;
    }

    private async Task AnswerDiscursiveAsync()
    {
        if (userId is null || question is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status401Unauthorized;
            return;
        }

        var answer = await Bank.AnswerDiscursiveAsync(userId, question.Id, AnswerText);
        if (answer is null)
        {
            invalidChoice = true;
            HttpContext.Response.StatusCode = StatusCodes.Status400BadRequest;
            return;
        }

        discursiveAnswer = answer;
    }

    private static string OptionClass(QuestionOption option, QuestionOption chosen) =>
        option.IsCorrect ? "border-success" : option.Id == chosen.Id ? "border-danger" : "";
}
