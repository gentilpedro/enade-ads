@using EnadeAds.Questions

@switch (Outcome)
{
    case AttemptOutcome.Correct:
        <span class="badge text-bg-success"><Icon Name="check" /> Acertou</span>
        break;
    case AttemptOutcome.Wrong:
        <span class="badge text-bg-danger"><Icon Name="x" /> Errou</span>
        break;
    case AttemptOutcome.Answered:
        <span class="badge text-bg-info"><Icon Name="pencil" /> Respondida</span>
        break;
}

@code {
    [Parameter]
    public AttemptOutcome Outcome { get; set; }
}
