@using EnadeAds.Study

@if (Status is { } status)
{
    <span class="rm-mark" aria-hidden="true"><Icon Name="@Symbol(status)" /></span><span class="visually-hidden">@status.Name(): </span>
}

@code {
    [Parameter]
    public NodeStatus? Status { get; set; }

    private static string Symbol(NodeStatus status) => status switch
    {
        NodeStatus.Done => "check",
        NodeStatus.InProgress => "half",
        _ => "skip",
    };
}
