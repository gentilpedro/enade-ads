@page "/Error"
@using System.Diagnostics

<PageTitle>Erro</PageTitle>

<h1 class="text-danger">Algo deu errado</h1>
<p>Não conseguimos concluir o seu pedido. Tente de novo em alguns instantes ou volte para a <a href="">página inicial</a>.</p>

@* O código ajuda a achar o erro nos logs; os detalhes técnicos ficam só no servidor. *@
@if (ShowRequestId)
{
    <p class="small text-body-secondary">
        Se o problema continuar, informe este código: <code>@RequestId</code>
    </p>
}

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
